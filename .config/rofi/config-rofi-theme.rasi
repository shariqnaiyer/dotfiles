/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Main Config Rofi Theme */

@import "~/.config/rofi/config.rasi"  

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Mainbox ---- */
mainbox {
  children: [ "inputbar", "message", "listview" ];
}

/* ---- Custombox ---- */
/* Override custombox to ensure listview is visible for themes that use it */
custombox {
  spacing:                     0px;
  background-color:            inherit;
  text-color:                  inherit;
  orientation:                 vertical;
  children:                    [ "listview" ];
}

/* ---- Entry input ---- */
entry {
  expand: true;
  placeholder: " ⬇️  Select Which Rofi Theme wanted to apply";
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  margin: 10px;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element-icon {
  size: 32px;
  margin: 0px 10px 0px 0px;
}
element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  margin: 0px;
  padding: 0px;
}

/* ---- Message ---- */
message {
  padding: 10px;
  border-radius: 10px;
  background-color: inherit;
}

textbox {
  text-color: inherit;
  background-color: inherit;
}
